<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
  </ItemGroup>

  <!-- PosixOpen is compiled into the netstandard2.0 SDK build only. Link it here so its open(2)
       helper can be exercised directly on this net8/net10 host. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SNAPSHOT_POSIX_OPEN_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Featureflip.Client\Internal\PosixOpen.cs" Link="Snapshot\PosixOpen.linked.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Featureflip.Client\Featureflip.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="golden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
