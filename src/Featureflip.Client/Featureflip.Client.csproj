<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Featureflip.Client</RootNamespace>
    <PackageId>Featureflip.Client</PackageId>
    <Version>2.11.0</Version>
    <Description>Feature flag client SDK for Featureflip</Description>
    <!-- NuGet renders no notes without this, so the package page said nothing about
         what changed in any version (#2553). Points at the PUBLIC mirror's Release:
         the monorepo is private, so a link there 404s for every consumer of this
         package. $(Version) is rewritten from the tag at publish time, and the mirror
         tags as plain v<version>, so this resolves to the right release. -->
    <PackageReleaseNotes>https://github.com/canopy-labs/featureflip-dotnet/releases/tag/v$(Version)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Featureflip.Client.Tests" />
    <InternalsVisibleTo Include="Featureflip.Client.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
  </ItemGroup>
</Project>
